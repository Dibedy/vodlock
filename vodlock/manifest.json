{
  "manifest_version": 3,
  "name": "SPOILLESS - Spoiler Safe VODs",
  "version": "3.0.0",
  "description": "Spoiler-safe YouTube, Twitch and vods.space viewing with safe round navigation.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.twitch.tv/*",
    "https://twitch.tv/*",
    "https://vods.space/*",
    "https://www.vods.space/*",
    "https://www.youtube-nocookie.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "SPOILLESS",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "round-index.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vods.space/*",
        "https://www.vods.space/*",
        "https://www.youtube.com/embed/*",
        "https://youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["vodspace.js"],
      "css": ["content.css", "vodspace.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["round-index.js", "index-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
